{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkyFall",
  "version": "0.1.0",
  "identifier": "dev.skyfall.desktop",
  "build": {
    "frontendDist": "../core/assets/dashboard"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SkyFall",
        "url": "/index.html",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "trayIcon": {
      "id": "skyfall-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "AI system monitor",
    "longDescription": "SkyFall is an AI system monitor: live CPU, memory, network, GPU, disk and process telemetry with anomaly alerts."
  }
}
